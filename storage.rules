rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'Sefa.Sevim@outlook.com' ||
        request.auth.token.email == 'sefa.sevim@outlook.com' ||
        request.auth.token.email == 'sefasevim46@gmail.com' ||
        request.auth.token.email == 'omersvm0606@gmail.com'
      );
    }

    match /images/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|avif)');
      allow delete: if isAdmin();
    }
  }
}
