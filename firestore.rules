rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'Sefa.Sevim@outlook.com' ||
        request.auth.token.email == 'sefa.sevim@outlook.com' ||
        request.auth.token.email == 'sefasevim46@gmail.com' ||
        request.auth.token.email == 'omersvm0606@gmail.com'
      );
    }

    function validEmail(value) {
      return value is string
        && value.size() >= 5
        && value.size() <= 254
        && value.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    function validAppointment() {
      return request.resource.data.keys().hasOnly([
          'client_name', 'client_email', 'client_phone', 'appointment_date',
          'notes', 'status', 'created_at', 'consent_version'
        ])
        && request.resource.data.client_name is string
        && request.resource.data.client_name.size() >= 2
        && request.resource.data.client_name.size() <= 100
        && validEmail(request.resource.data.client_email)
        && request.resource.data.client_phone is string
        && request.resource.data.client_phone.size() >= 10
        && request.resource.data.client_phone.size() <= 20
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 1000
        && request.resource.data.status == 'pending'
        && request.resource.data.appointment_date is timestamp
        && request.resource.data.appointment_date > request.time
        && request.resource.data.appointment_date < request.time + duration.value(180, 'd')
        && request.resource.data.created_at == request.time
        && request.resource.data.consent_version == '2026-09-13';
    }

    function validMessage() {
      return request.resource.data.keys().hasOnly([
          'name', 'email', 'phone', 'message', 'createdAt', 'read', 'consent_version'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && validEmail(request.resource.data.email)
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 20
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 2000
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.consent_version == '2026-09-13';
    }

    match /content/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{document} {
      allow read: if document != 'notifications' || isAdmin();
      allow write: if isAdmin();
    }

    match /services/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /faqs/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /media/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /appointments/{appointmentId} {
      allow read: if isAdmin();
      allow create: if appointmentId.matches('^slot_.*$') && validAppointment();
      allow update, delete: if isAdmin();
    }

    match /messages/{messageId} {
      allow read: if isAdmin();
      allow create: if validMessage();
      allow update, delete: if isAdmin();
    }

    match /workingHours/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
